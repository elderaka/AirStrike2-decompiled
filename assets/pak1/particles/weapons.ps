PS_LASER_ISKRA {
	blend_mode	BLEND_ADD
	
	texture		"gfx\flare_orange_green_small.tga" 2 1

	emit_rate	5
//	emit_mode	EMIT_ONCE

	life_time	0.3

	init_offset	0 0 2 0 40 0
	init_size	2 0
	init_frame	0 0
	init_color	1 1 1 1
        init_velocity   0 0 -15 20 20 -10
	size 		-3

	fade_mode	FADE_LINEAR
	accel		3 1 -10

}

PS_LASER_NAKOPL {
	blend_mode	BLEND_ADD
	
