



PS_METEORITE_FALLING {
        blend_mode      BLEND_ADD
        rflag           RF_NODEPTHTEST

        texture         "gfx\weapons\combust_flamefrower.tga" 4 2

        emit_rate       20

        life_time       0.8

        init_offset     0 0 0 0 0 0
        init_size       32 2
        init_frame      0 7
        init_color      1 1 1 1
        init_velocity   0 0 0 1 1 -3
        size            -18

        fade_mode       FADE_LINEAR
        fade_factor     0.2
        accel           0 0 0
}


PS_METEORITE_FALLING_SMOKE {
	blend_mode      BLEND_FILTER
	rflag		RF_NODEPTHTEST

	texture		"gfx\smoke3.tga" 4 2

	emit_rate	8

	life_time	1.6

	init_offset	0 0 0 0 0 0
	init_size	43 1
//	init_frame	0 8
	init_color	1 1 1 1
	init_velocity	0 0 0  1 1 -3
	
	size		-15

	fade_mode	FADE_LINEAR
	fade_factor	0.6
	anim_mode	ANIM_LINEAR
}


