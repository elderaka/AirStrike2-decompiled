PS_E_METEORITE {
	blend_mode	BLEND_ADD
	rflag		RF_NODEPTHTEST
	
	texture         "gfx\weapons\combust_flamefrower.tga" 4 2

	emit_rate	30

	life_time	0.3

	init_offset	0 0 0 1 1 1
	init_size	3 1
	init_frame	0 7
	init_color	1 1 1 1
        init_velocity   0 0 0 1 -1 1
	size 		-6

	fade_mode	FADE_LINEAR
	fade_factor	0.7
	accel		0 0 0
}


