
////////////////////EXPLOSION//////////////////////


PS_EXPLOSION_SPARKS {
	blend_mode	BLEND_ADD
	texture 	"gfx\effects\gibspark.tga" 1 1
	rflag		RF_NODEPTHTEST

	emit_mode	EMIT_ONCE
	emit_rate	10
	
	life_time	1.7

	init_frame	0 0
	init_offset	0 0 6 1 1 1
	init_size	12 2
	init_color	1 1 1 1
	init_velocity	0 0 50 60 60 50
	size		-5

	fade_mode	FADE_LINEAR
	accel		0 0 -100
}

