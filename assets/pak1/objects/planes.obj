plane_f15_sandhaki {
	touch	TOUCH_PLAYER

        health  700
        enemy

	score	1000

        model   "models/planes/f15/plane_f15.mdl"
        skin    "models/planes/f15/plane3_sand.tga"
        shadow  SHADOW_PLANAR_LOW

	attach  "helic_redflare" "tag_flare1"
	attach  "helic_redflare" "tag_flare2"
        attach abs night "svet_far" "tag_fara"
        attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_HELIC_ALMOSTDEAD" origin
	attach	PS_F15  "tag_smoke"

        script  "scripts\planes\f15\plane.scr"
} 

