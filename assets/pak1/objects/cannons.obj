rocketlaucher_left {
	model	"models/cannons/rocketlaucher_left.mdl"
	skin	"models/cannons/rocketlaucher.tga"
        rflag   RF_NOCULLING

	script	"scripts\cannons\rocketlaucher_left.scr"
}

rocketlaucher_right {
	model	"models/cannons/rocketlaucher_right.mdl"
	skin	"models/cannons/rocketlaucher.tga"
        rflag   RF_NOCULLING
	
	script	"scripts\cannons\rocketlaucher_right.scr"
}

rocketlaucher {
	health	500
	flag    FL_ONGROUND
	enemy
	score   500

	rflag   RF_NOCULLING
	shadow  SHADOW_PROJECTED
	model	"models/cannons/rocketlaucher.mdl"
	skin	"models/cannons/rocketlaucher.tga"

	attach abs	"rocketlaucher_left" "tag_gate"
	attach abs	"rocketlaucher_right" "tag_gate"	

	script	"scripts\cannons\rocketlaucher.scr"
}


