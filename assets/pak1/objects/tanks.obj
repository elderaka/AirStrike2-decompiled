//////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////// tank_zsu /////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////

tank_zsu_green_guns {
	model	"models/tanks/tank_zsu/tank_zsu_gun.mdl"
	skin	"models/tanks/tank_zsu/tank_zsu_green.tga"

	envmode	ENV_GLITTER
	envmap  "gfx\chrome3.tga"

       script	"scripts\tanks\tank_zsu\tank_zsu_guns.scr"
}

tank_zsu_green_cannon {
	model	"models/tanks/tank_zsu/tank_zsu_turret.mdl"
	skin	"models/tanks/tank_zsu/tank_zsu_green.tga"

	attach abs id "GUNS"  "tank_zsu_green_guns"  "tag_gun"

       script	"scripts\tanks\tank_zsu\tank_zsu_turret.scr"
}

tank_zsu_green {
	health	700
	flag    FL_ONGROUND_NORMAL
	enemy

	score	700

	skid_mark  20 0 9 "gfx/marks/tankmark1.tga"
	skid_mark -20 0 9 "gfx/marks/tankmark1.tga"

	model	"models/tanks/tank_zsu/tank_zsu.mdl"
	skin	"models/tanks/tank_zsu/tank_zsu_green.tga"
	shadow	SHADOW_PLANAR_LOW

	attach abs "tank_zsu_green_cannon" "tag_turet"	
	attach abs night "svet_far" "tag_Light01"
	attach abs night "svet_far_wol" "tag_Light02"
	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_ALMOSTDEAD" origin

       script	"scripts\tanks\tank_zsu\tank_zsu.scr"
}


