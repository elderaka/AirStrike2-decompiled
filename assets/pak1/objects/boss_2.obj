
boss_2 {
	touch	TOUCH_PLAYER
	flag	FL_TEMPORARY
	
        model   "models\bosses\boss_2\boss_2_base.mdl"
        skin    "models\bosses\boss_2\boss_2_base.tga"

        attach  abs "boss_2_base_turret_l"  "tag_turret_l"
        attach  abs "boss_2_base_turret_r"  "tag_turret_r"
        attach  abs id "ROCKET1" "boss_2_base_rocket_l"  "tag_rocket_l"
        attach  abs id "ROCKET2" "boss_2_base_rocket_r"  "tag_rocket_r"

        script  "scripts\bosses\boss_2\boss_2.scr"
}

boss_2_base_turret_l {

        model   "models\bosses\boss_2\boss_2_base_turret_l.mdl"
        skin    "models\bosses\boss_2\boss_2_guns.tga"

        attach  id "GUNS" abs "boss_2_base_turret_l_guns" "tag_turret_l_guns"

	attach  abs "svet_far_helic" "tag_fara02"
	attach  abs "svet_far_helic" "tag_fara03"

        script  "scripts\bosses\boss_2\boss_2_base_turret.scr"
}

boss_2_base_turret_l_guns {

        model   "models\bosses\boss_2\boss_2_base_turret_l_guns.mdl"
        skin    "models\bosses\boss_2\boss_2_guns.tga"
	envmap	"gfx\envmap3.tga"
	envmode	ENV_GLITTER

        attach  abs "boss_2_base_turret_l_guns_pod" "tag_turret_l_guns_pod"

        script  "scripts\bosses\boss_2\boss_2_base_guns.scr"
}

boss_2_base_turret_r_guns {
        model   "models\bosses\boss_2\boss_2_base_turret_r_guns.mdl"
        skin    "models\bosses\boss_2\boss_2_guns.tga"
	envmap	"gfx\envmap3.tga"
	envmode	ENV_GLITTER

        attach  abs "boss_2_base_turret_r_guns_pod" "tag_turret_r_guns_pod"

        script  "scripts\bosses\boss_2\boss_2_base_guns_r.scr"
}

boss_2_base_turret_r_guns_pod {
        model   "models\bosses\boss_2\boss_2_base_turret_r_guns_pod.mdl"
        skin    "models\bosses\boss_2\boss_2_guns.tga"
}

boss_2_base_turret_l_guns_pod {

        model   "models\bosses\boss_2\boss_2_base_turret_l_guns_pod.mdl"
        skin    "models\bosses\boss_2\boss_2_guns.tga"

}

boss_2_base_turret_r {

        model   "models\bosses\boss_2\boss_2_base_turret_r.mdl"
        skin    "models\bosses\boss_2\boss_2_guns.tga"

        attach  id "GUNS" abs "boss_2_base_turret_r_guns" "tag_turret_r_guns"
	attach  abs "svet_far_helic" "tag_fara04"
	attach  abs "svet_far_helic" "tag_fara05"

        script  "scripts\bosses\boss_2\boss_2_base_turret.scr"
