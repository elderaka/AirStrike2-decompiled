boss_2_base_turbina_l {
	enemy
	health	7000
	touch	TOUCH_PLAYER
	flag    FL_TEMPORARY

        model   "models\bosses\boss_2\boss_2_turbina_l.mdl"
        skin    "models\bosses\boss_2\boss_2_base.tga"

	attach	abs id "FIRE" PS_BOSS2_FIRE "tag_sled03"
	attach	PS_BOSS2_SMOKE  "tag_sled03"

        script  "scripts\bosses\boss_2\boss_2_turbina_l.scr"
}

