	shadow	SHADOW_PLANAR_LOW

	model	"models\fire_truck\fire_truck_wh.mdl"
	skin	"models\fire_truck\fire_truck.tga"

	script	"scripts\transport\fire_truck\fire_truck_wheel.scr"
}

fire_truck {

	health	450
	flag    FL_ONGROUND_NORMAL
	score   600
        rflag   RF_NOCULLING
	shadow	SHADOW_PLANAR_LOW

	skid_mark  16 29 9 "gfx/marks/jeepmark1.tga"
	skid_mark -16 29 9 "gfx/marks/jeepmark1.tga"

	model	"models\fire_truck\fire_truck.mdl"
	skin	"models\fire_truck\fire_truck.tga"

	attach abs "fire_truck_wh" "tag_wh01"
	attach abs "fire_truck_wh" "tag_wh02"
	attach abs "fire_truck_wh" "tag_wh03"
	attach abs "fire_truck_turret" "tag_turret"
	attach abs "fire_truck_lestnica" "tag_lestnica"

	attach abs night "svet_far" "tag_fara_01"
	attach abs night "svet_far_wol" "tag_fara_02"
	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_ALMOSTDEAD" origin
	attach	"whiteflare_small" "tag_flare01"
	attach	"whiteflare_small" "tag_flare02"
	attach	"whiteflare_small" "tag_flare03"
	attach	"whiteflare_small" "tag_flare04"

	script	"scripts\transport\fire_truck\fire_truck.scr"
}

