	score	500

	skid_mark  13 45 7 "gfx/marks/jeepmark1.tga"
	skid_mark -13 45 7 "gfx/marks/jeepmark1.tga"

        model   "models\gruzovik\gruzovik_oil.mdl"
        skin    "models\gruzovik\gruzovik_oil.tga"
