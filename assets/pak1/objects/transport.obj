
svet_orangeflasher {
	model   "models/misc/svet_far.mdl"
        skin    "models/misc/svet_far_orange.tga"
        blend   BLEND_ADD
	rflag   RF_NOCULLING
        rflag   RF_NODEPTHWRITE

	light_dir 400 1.1 0.9 0 0 1 -0.2 100
} 
 
gruzovik_flasher {
        model   "models\rocketlauncher_mobil\rocketlauncher_flasher.mdl"
        skin    "models\rocketlauncher_mobil\raketnitsa.tga"

        attach abs "svet_orangeflasher" "tag_light"

        envmap  "gfx\envmap3.tga"
        envmode ENV_GLITTER

        script  "scripts\rocketlauncher\rl_flasher.scr"
}

gruzovik {
        health  200
        flag    FL_ONGROUND_NORMAL
        enemy
	score	200

	skid_mark  8 27 4 "gfx/marks/jeepmark1.tga"
	skid_mark -8 27 4 "gfx/marks/jeepmark1.tga"

        model   "models\gruzovik\gruzovik.mdl"
        skin    "models\gruzovik\gruzovik.tga"
        shadow  SHADOW_PLANAR_LOW

	attach  "helic_redflare"        "tag_flare"
        attach abs "gruzovik_flasher" "tag_flasher"
        attach abs night "svet_far" "tag_fara1"
        attach abs night "svet_far_wol" "tag_fara2"
        attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_ALMOSTDEAD" origin

        script  "scripts\transport\gruzovik.scr"
}

gruzovik_oil {
        health  600
        flag    FL_ONGROUND_NORMAL
