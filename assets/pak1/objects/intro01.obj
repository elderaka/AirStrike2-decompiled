plane_cargo_green_intro {
        
        health  400
        enemy
        flag    FL_TEMPORARY	
	score	400

        model   "models/planes/cargo/cargo.mdl"
        skin    "models/planes/cargo/cargo_green.tga"
        shadow  SHADOW_PLANAR_LOW

	envmode	ENV_GLITTER
	envmap  "gfx\chrome3.tga"

	attach  "helic_redflare" "tag_flare01"
	attach  "helic_redflare" "tag_flare02"
	attach  "whiteflare_small" "tag_flare03"
	attach  "whiteflare_small" "tag_flare04"
	attach  "whiteflare_small" "tag_flare05"
	attach  "whiteflare_small" "tag_flare06"

	attach	PS_F15  "tag_jet01"
	attach	PS_F15  "tag_jet02"

        script  "scripts\planes\plane_cargo\plane_cargo.scr"
}
