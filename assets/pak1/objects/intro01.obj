heli_uh_intro  {

	model	"models\helics\uh\uh.mdl"
	skin	"models\helics\uh\uh_snow.tga"
	shadow	SHADOW_PLANAR_HIGH
        flag    FL_TEMPORARY
	
	health	600
	enemy
	score   600

	attach	"helic_redflare"	"tag_flare01"
        attach	"helic_redflare"	"tag_flare02"
	attach   abs	"vint_a4_red"	"tag_vint01"
	
        attach abs "svet_far_helic" "tag_fara02"

	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_HELIC_ALMOSTDEAD" origin
	
	script	"scripts\helics\heli_uh\heli_uh_intro.scr"

}
