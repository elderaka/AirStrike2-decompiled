uaz_snow_wh_int {

	rflag   RF_NOCULLING

	model	"models\jeeps\uaz\uaz_wh.mdl"
	skin	"models\jeeps\uaz\uaz_snow.tga"

	script	"scripts\jeeps\uaz\uaz_wheel.scr"
}

uaz_snow_gun_int {

	model	"models\jeeps\uaz\uaz_gun.mdl"
	skin	"models\jeeps\uaz\uaz_snow.tga"
}

uaz_snow_turret_int {

	model	"models\jeeps\uaz\uaz_turret.mdl"
	skin	"models\jeeps\uaz\uaz_snow.tga"

	attach	abs   "uaz_snow_gun_int" "tag_gun"	

	script	"scripts\jeeps\uaz\uaz_turret.scr"
}

uaz_snow_intro {

	health	60
	flag    FL_ONGROUND_NORMAL
	shadow	SHADOW_PLANAR_LOW
	enemy
	score 60
        flag    FL_TEMPORARY	

	model	"models\jeeps\uaz\uaz.mdl"
	skin	"models\jeeps\uaz\uaz_snow.tga"

	skid_mark  11 16 6 "gfx/marks/jeepmark1.tga"
	skid_mark -11 16 6 "gfx/marks/jeepmark1.tga"

	attach	abs "uaz_snow_turret_int" "tag_turret"	
	attach	abs "uaz_snow_wh_int" "tag_wh01"	
	attach	abs "uaz_snow_wh_int" "tag_wh02"	

	attach abs  "svet_far" "tag_fara01"
	attach abs  "svet_far_wol" "tag_fara02"
	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_ALMOSTDEAD" origin

	script	"scripts\jeeps\uaz\uaz.scr"

}

