
cutter_small_guns_blue_turret_intr {
        model   "models\ships\cutter_small_guns\cutter_small_guns_turret.mdl"
        skin    "models\ships\cutter_small_guns\cutter_small_guns_blue.tga"

        attach   "cutter_small_guns_blue_gun_intr" "tag_gun"
        attach abs  "svet_far" "tag_gun"
	
	script	"scripts\ships\cutter_small_guns\cutter_small_guns_turret.scr"
}

cutter_small_guns_blue_gun_intr {
        model   "models\ships\cutter_small_guns\cutter_small_guns_gun.mdl"
        skin    "models\ships\cutter_small_guns\cutter_small_guns_blue.tga"
}

cutter_intro {
        health  500
        enemy
	
	flag	FL_ONWATER
        flag    FL_TEMPORARY

	score	400

        model   "models\ships\cutter_small_guns\cutter_small_guns.mdl"
        skin    "models\ships\cutter_small_guns\cutter_small_guns_blue.tga"

        attach  "cutter_small_guns_blue_turret_intr" "tag_turret"
        attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_ALMOSTDEAD" origin

        attach  "whiteflare_small" "tag_flare03"
        attach  "whiteflare_small" "tag_flare01"
        attach  "whiteflare_small" "tag_flare02"
        attach  "whiteflare_small" "tag_flare04"
        attach  "helic_redflare" "tag_flare05"

	attach abs id "SPLASHES" PS_SHIP_SPLASHES "tag_splash"

	script	"scripts\ships\cutter_small_guns\cutter_small_guns.scr"
}
