//        attach abs "boss_1_bashnya_kabina" "tag_kabina"
        attach abs id "LUK1" "boss_1_bashnya_luk_l" "tag_luk_l"
        attach abs id "LUK2" "boss_1_bashnya_luk_r" "tag_luk_r"
        attach abs "boss_1_bashnya_hrom" "tag_hrom"
        attach abs "boss_1_bashnya_turret" "tag_bashnya_turret"
