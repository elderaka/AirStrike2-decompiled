
boss_1_helic {
	touch   TOUCH_PLAYER
	model	"models\helics\helic_small\helic_small3.mdl"
	skin	"models\helics\helic_small\helic_small3_yellow.tga"
	shadow	SHADOW_PLANAR_HIGH

	envmode	ENV_GLITTER
	envmap  "gfx\chrome3.tga"
	
	health	250
	enemy

	score   200

	attach	"helic_redflare"	"tag_redflare01"
	attach	"helic_redflare"	"tag_redflare02"
	attach	abs "vint_small2"		"tag_stab"

	attach abs night "svet_far_helic" "tag_fara"

	attach abs	"vint_a3_red"	"tag_vint"
	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_HELIC_ALMOSTDEAD" origin	

	script	"scripts\bosses\boss_1\boss_1_helic.scr"
}

boss_1 {
	flag    FL_ONGROUND_NORMAL

	flag    FL_TEMPORARY

        model   "models\bosses\boss_1\boss_1_base.mdl"
        skin    "models\bosses\boss_1\boss_1_base.tga"


        attach abs id "COVER" "boss_1_bashnya" "tag_bashnya"

        attach abs "boss_1_wh" "tag_wh"
        attach abs "boss_1_wh02" "tag_wh02"
        attach abs "boss_1_wh02" "tag_wh03"
        attach abs "boss_1_wh02" "tag_wh04"

	attach id "TURRET1" "boss_1_turret_small" "tag_turret_small01"
	attach id "TURRET2" "boss_1_turret_small" "tag_turret_small02"

	script	"scripts\bosses\boss_1\boss_1_base.scr"
}



boss_1_wh {
        model   "models\bosses\boss_1\boss_1_wh.mdl"
        skin    "models\bosses\boss_1\boss_1_base.tga"

