boss_1_rapidgun_proj {
	touch	TOUCH_PLAYER

        damage  13

	type    TYPE_SPRITE
	skin    "models/weapons/sharik_green.tga"
	blend   BLEND_ADD

	frames  1 1
	min     -10 -10   0 0
	max     10 10     1 1

	attach  PS_FBALL_BIG_RED   "origin"

	script	"scripts\weapons_enemy\fball_big\fball.scr"
}

boss_1_rapidgun_flash {
	model	"models\weapons_enemy\mgun\flash.mdl"
	skin	"models\weapons\impulse\igun_flash.tga"
	blend	BLEND_ADD
	flag	FL_TEMPORARY

	rflag	RF_NOCULLING
	rflag	RF_NODEPTHWRITE
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT

	attach	"boss_1_rapidgun_flash2" "origin"

	script	"scripts\weapons\laser\flash.scr"
}

boss_1_rapidgun_flash2 {
	type    TYPE_SPRITE
	skin    "models\weapons\plasma\bpg_flash.tga"
	blend   BLEND_ADD

	flag    FL_TEMPORARY

	min     -55 -55   0 0
	max     55 55     1 1

	script  "scripts\weapons\laser\flash.scr"
}


boss1_expl_big {
	flag    FL_NODRAW
	attach  PS_EXPLOSION_SPARKS "origin"
	attach  PS_EXPLOSION_LAND_SPARKS_BIG "origin"
	script	"scripts\bosses\boss_1\boss_1_expl_big.scr"
}

boss1_expl {
	flag	FL_TEMPORARY
	type	TYPE_SPRITE

	skin	"gfx\weapons\expl_missile.tga"
	blend	BLEND_ADD
	
	rflag	RF_NODEPTHTEST

	frames	2 1
	min	-35 -35  0 0
	max	35 35    0.5 1	

	script	"scripts\bosses\boss_1\boss_1_expl.scr"
}
