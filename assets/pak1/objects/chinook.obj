
heli_chinook_doors {
	model	"models\helics\chinook\chinook_doors.mdl"
	skin	"models\helics\chinook\chinook.tga"
}


heli_chinook {
	enemy

	touch   TOUCH_PLAYER
	model	"models\helics\chinook\chinook.mdl"
	skin	"models\helics\chinook\chinook.tga"
	shadow	SHADOW_PLANAR_HIGH
	
	health	7000
	score   7000

	attach	"helic_redflare" "tag_flare01"
	attach	"helic_redflare" "tag_flare02"

	attach abs "vint_c4_blue_vbig" "tag_vint01"
	attach abs "vint_c4_blue_vbig" "tag_vint02"

	attach	PS_F15 "tag_smoke01"
	attach	PS_F15 "tag_smoke02"

	attach abs id "CHINOOK_DOORS" "heli_chinook_doors" "tag_doors"
	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_HELIC_ALMOSTDEAD" origin
	
	script	"scripts\helics\heli_chinook\bot5.scr"
}

///////////////////////////////////////////////////////////////////////////
///////////////////////////// jeep_chinook ////////////////////////////////
///////////////////////////////////////////////////////////////////////////

jeep_chinook {

	enemy
	health	250

//	flag    FL_ONGROUND_NORMAL

	score 250

	model	"models/jeeps/sj3/sj3.mdl"
	skin	"models/jeeps/sj3/sj3_green.tga"
	shadow	SHADOW_PLANAR_LOW

	skid_mark  10 16 4 "gfx/marks/jeepmark1.tga"
	skid_mark -10 16 4 "gfx/marks/jeepmark1.tga"

	attach abs "jeep_helic_turret_green" "tag_turret"	
	attach abs "jeep_helic_wh_green" "tag_wh01"	
	attach abs "jeep_helic_wh_green" "tag_wh02"	
	attach abs night "svet_far" "tag_fara01"
	attach abs night "svet_far_wol" "tag_fara02"
	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_ALMOSTDEAD" origin

	script	"scripts\helics\heli_chinook\jeep.scr"
}
