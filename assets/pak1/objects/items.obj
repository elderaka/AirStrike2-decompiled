///////////////////////BONUSES///////////////////////////////////
/////////////////////////////////////////////////////////////////

item_lightingbomb {
        touch   TOUCH_PLAYER
	flag    FL_TEMPORARY

	model	"models\items\bonuses\lightingb.mdl"
	skin	"models\items\bonuses\lightingb.tga"
	envmap	"gfx\envmap1.tga"
	envmode	ENV_GLITTER
//	rflag	RF_NOLIGHTING

//	attach  PS_BONUS "origin"
//	attach night "light_magenta" origin
//	attach abs "ammo_shell2" "origin"
	attach "i_lightingbomb_proj" "origin"


	script	"scripts\items\bonuses\i_lightingb.scr"
}


i_lball_flare {
	type	TYPE_SPRITE
	blend	BLEND_ADD
//	rflag	RF_NODEPTHTEST
	sort	SORT_EFFECT
	skin	"models\weapons\bfg\ballflare.tga"

	min	-12 -12 0.0 0.0
	max	12 12 1.0 1.0	
}

i_lball_plane {
	model	"models\items\bonuses\plane.mdl"
	skin	"models\weapons\bfg\bfg_plane.tga"
	blend	BLEND_ADD

	rflag	RF_NOCULLING
        rflag   RF_NODEPTHTEST
        rflag   RF_NOLIGHTING
        sort    SORT_EFFECT

	script	"scripts\items\bonuses\i_lightingb_plane.scr"
}

i_lightingbomb_proj {
	model	"models\items\bonuses\sfera.mdl"
	blend	BLEND_ADD
	light	150 0.3 0.3 3

//        rflag   RF_NODEPTHTEST
        rflag   RF_NOLIGHTING
        sort    SORT_EFFECT

	script	"scripts\items\bonuses\i_lightingb_proj.scr"
	attach 	"i_lball_flare" "origin"

	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"
	attach abs "i_lball_plane" "origin"

}

