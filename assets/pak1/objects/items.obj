light_green {
	light   100 0.5 1.5 0.5
}

light_red {
        light   100 1.5 0.5 0.5
}

light_blue {
        light   100 0.5 0.5 1.5
}

light_yellow {
        light   100 1 1 0.5
}

light_magenta {
        light   100 1 0.5 1
}


