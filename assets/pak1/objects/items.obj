

flare_blue {
	type	TYPE_SPRITE
	blend	BLEND_ADD
	rflag	RF_NODEPTHWRITE
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT

	skin	"gfx\effects\flare_blue.tga"

	min	-20 -20  0.0 0.0
	max	 20  20  1.0 1.0	

	script	"scripts\items\flare.scr"
}

flare_red {
	type	TYPE_SPRITE
	blend	BLEND_ADD
	rflag	RF_NODEPTHWRITE
	sort	SORT_EFFECT
	skin	"gfx\effects\flare_red.tga"

	min	-20 -20 0.0 0.0
	max	20 20 1.0 1.0	

	script	"scripts\items\flare.scr"
}

flare_green {
	type	TYPE_SPRITE
	blend	BLEND_ADD
	rflag	RF_NODEPTHWRITE
	sort	SORT_EFFECT
	skin	"gfx\effects\flare_green.tga"

	min	-20 -20 0.0 0.0
	max	20 20 1.0 1.0	

	script	"scripts\items\flare.scr"
}






item_life {
        touch   TOUCH_PLAYER
	model	"models\items\life.mdl"
	skin	"models\items\life.tga"

	flag    FL_TEMPORARY

	envmap	"gfx\envmap1.tga"
	envmode	ENV_GLITTER


	attach abs "satellite_vint"   "tag_vint"

	attach "flare_blue" "origin"
	script	"scripts\items\i_life.scr"
}


