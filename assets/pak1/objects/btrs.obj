/////////////////////BTR//////////////////////

btr_dead {
	model   "models/btrs/btr_dead.mdl"
	skin    "models/btrs/btr_dead.tga"	
	shadow	SHADOW_PLANAR_LOW

	attach id "CAMPFIRE" "campfire" "origin"
	attach id "CAMPFIRE_SMALL" "campfire_small" "origin"
	script	"scripts\dead2.scr"
}

btr_dead2 {
	model   "models/btrs/btr_dead2.mdl"
	skin    "models/btrs/btr_dead.tga"	
	shadow	SHADOW_PLANAR_LOW

	attach id "CAMPFIRE" "campfire" "origin"
	attach id "CAMPFIRE_SMALL" "campfire_small" "origin"
	script	"scripts\dead2.scr"
}

/////////////////////////////////////////////////

btr_green_guns {
        model   "models/btrs/btr_small/btr_guns.mdl"
        skin    "models/btrs/btr_small/btr_green.tga"

        script  "scripts\btrs\btr\btr_guns.scr"
}


btr_green_cannon {
        model   "models/btrs/btr_small/btr_b.mdl"
        skin    "models/btrs/btr_small/btr_green.tga"

	attach	abs id "GUNS" "btr_green_guns" "tag_guns"	

        script  "scripts\btrs\btr\btr_cannon.scr"
}

btr_green {
        health  340
        flag    FL_ONGROUND_NORMAL
	enemy
	score   450

        model   "models/btrs/btr_small/btr.mdl"
        skin    "models/btrs/btr_small/btr_green.tga"
        shadow  SHADOW_PLANAR_LOW

	attach  "helic_redflare"        "tag_flare"
        attach abs "btr_green_cannon" "tag_cannon"
	attach abs night "svet_far" "tag_fara1"
	attach abs night "svet_far_wol" "tag_fara2"
	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_ALMOSTDEAD" origin

        script  "scripts\btrs\btr\btr.scr"
}


