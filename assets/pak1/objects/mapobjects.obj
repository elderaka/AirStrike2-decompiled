///////////=======Balon=======///////////////////////////

balon_gaz {
        health  100
	enemy
	flag FL_NONTARGET

	model	"models\mapobjects\barrel\balon_gaz.mdl"
	skin	"models\mapobjects\misc\misc.tga"

	shadow	SHADOW_PROJECTED

        envmap  "gfx\envmap3.tga"
        envmode ENV_GLITTER

        attach  id "GAZ" PS_BALON_GAZ "tag_fire"

        script  "scripts\barrel\balon_gaz.scr"
	flag    FL_ONGROUND
}

balon_gaz_dead {
        health  400
	enemy
	flag FL_NONTARGET

	model	"models\mapobjects\barrel\balon_gaz.mdl"
	skin	"models\mapobjects\misc\misc.tga"
	flag    FL_ONGROUND

	shadow	SHADOW_PROJECTED

        envmap  "gfx\envmap3.tga"
        envmode ENV_GLITTER

        attach  PS_FLAMEFROWER "tag_fire"
        attach  PS_FLAMEFROWER_BLUE "tag_fire"

        script  "scripts\barrel\balon_gaz_dead.scr"
}

