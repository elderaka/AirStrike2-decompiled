/////////////////////radars/////////////////////////

whiteflare_small {
        type    TYPE_SPRITE
        skin    "gfx\flare_white_red_small.tga"
        blend   BLEND_ADD
        sort    SORT_EFFECT
        rflag   RF_NODEPTHWRITE
        min     -2 -2 0.0 0.0
        max     2 2 0.5 1
}

redflare_small {
        type    TYPE_SPRITE
        skin    "gfx\flare_white_red_small.tga"
        blend   BLEND_ADD
        sort    SORT_EFFECT
        rflag   RF_NODEPTHWRITE
        min     -3 -3  0.5 0.0
        max      3  3  1   1
}

