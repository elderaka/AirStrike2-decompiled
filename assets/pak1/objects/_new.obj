/////effects///////


expl_wave_meteorite {
	model	"models\misc\sphere.mdl"
	skin	"models\misc\hlanno.tga"
        blend	BLEND_ADD
	rflag	RF_NOLIGHTING
	rflag	RF_NODEPTHWRITE
	script	"scripts\effects\wave_meteorite.scr"
}


mark_big {
	type	TYPE_MARK
	skin	"gfx\mark.tga"
	blend	BLEND_FILTER
	min	-100 -100 0 0
	max	100 100 1 1
	script	"scripts\weapons\hit10.scr"
}


splash_big {
	model	"models\misc\splash.mdl"
	rflag	RF_NOLIGHTING
	rflag	RF_NODEPTHWRITE
	sort	SORT_ONGROUND
	blend	BLEND_ADD
	
	script	"scripts\effects\splash_big.scr"
}


expl_meteorite_falled {
	flag    FL_NODRAW
	script	"scripts\effects\expl_meteorite_falled.scr"
	attach  PS_EXPLOSION_SPARKS "origin"
	attach  PS_EXPLOSION_METEORITE_SPARKS "origin"
	attach  PS_EXPLOSION_METEORITE_SPARKS_RED "origin"
}

expl_meteorite {
	flag    FL_NODRAW
	script	"scripts\effects\expl_meteorite.scr"
	attach  PS_EXPLOSION_METEORITE_SPARKS "origin"
	attach  PS_EXPLOSION_METEORITE_SPARKS_RED "origin"
}

expl_meteorite_medium_falled {
	flag    FL_NODRAW
	script	"scripts\effects\expl_meteorite_medium_falled.scr"
	attach  PS_EXPLOSION_METEORITE_SPARKS "origin"
	attach  PS_EXPLOSION_METEORITE_SPARKS_RED "origin"
}

expl_meteorite_medium {
	flag    FL_NODRAW
	script	"scripts\effects\expl_meteorite_medium.scr"
	attach  PS_EXPLOSION_METEORITE_SPARKS "origin"
	attach  PS_EXPLOSION_METEORITE_SPARKS_RED "origin"
}


expl_ring_normalled {
	model	"models\misc\ring.mdl"
	skin	"models\misc\ring_fire.tga"
	rflag	RF_NOLIGHTING
	rflag	RF_NODEPTHTEST
	sort	SORT_ONGROUND
	blend	BLEND_ADD
	
	script	"scripts\effects\expl_ring_normalled.scr"
}


expl_ring_small_normalled {
	model	"models\misc\ring.mdl"
	skin	"models\misc\ring_fire.tga"
	rflag	RF_NOLIGHTING
	rflag	RF_NODEPTHTEST
	sort	SORT_ONGROUND
	blend	BLEND_ADD
	
	script	"scripts\effects\expl_ring_small_normalled.scr"
}


iceberg {
	model	"models\_new\iceberg.mdl"
	skin	"models\_new\iceberg.tga"

	flag	FL_ONWATER

	envmode	ENV_GLITTER
	envmap  "gfx\chrome3.tga"

	blend	BLEND_ADD
	rflag	RF_NOCULLING


	shadow	SHADOW_PROJECTED
	flag    FL_ONGROUND
}

ldina {
	model	"models\_new\ldina.mdl"
	skin	"models\_new\ldina.tga"

	flag	FL_ONWATER

	//envmode	ENV_GLITTER
	//envmap  "gfx\chrome3.tga"

	blend	BLEND_ADD
	rflag	RF_NOCULLING


	shadow	SHADOW_PROJECTED
	flag    FL_ONGROUND
	rflag	RF_NOLIGHTING

        
}

speed_up_N_A_R_K_O_M_A_N {
	flag 	FL_NODRAW
	flag    FL_TEMPORARY
	script	"scripts\bonuslevel_spdup1.scr"
}	

