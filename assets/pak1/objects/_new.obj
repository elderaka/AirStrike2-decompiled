

Empty {
	script "scripts\empty.scr"
}


stop_camera {
	script	"scripts\stop.scr"
}

meteorite_flare2 {
	type	TYPE_SPRITE
	skin	"gfx\effects\gibflare.tga"
	blend	BLEND_ADD
	rflag	RF_NODEPTHWRITE

	min	-100 -100 0.0 0.0
	max	100 100 1.0 1.0	
}

meteorite_small_flare {
	type	TYPE_SPRITE
	skin	"gfx\effects\gibflare.tga"
	blend	BLEND_ADD
	rflag	RF_NODEPTHWRITE

	min	-50 -50 0.0 0.0
	max	50 50 1.0 1.0	
}


meteorite_gray {
	touch	TOUCH_CIVILIAN
	touch   TOUCH_PLAYER

	flag FL_NONTARGET

        health  500
        enemy

	model	"models\_new\meteorite1.mdl"
	skin	"models\_new\meteorite.tga"
	shadow	SHADOW_PROJECTED

	attach  id "PS_FIRE" PS_METEORITE_FALLING "origin"
	attach  id "PS_SMOKE" PS_METEORITE_FALLING_SMOKE "origin"

	attach	"meteorite_flare2" "origin"

	script	"scripts\_new\meteorite_falling.scr"
}


meteorite_gray_dead {
        flag    FL_ONGROUND
	model	"models\_new\meteorite1.mdl"
	skin	"models\_new\meteorite.tga"
}


meteorite_gray_medium {
	touch	TOUCH_CIVILIAN
	touch   TOUCH_PLAYER
	flag FL_NONTARGET

        health  300
        enemy
	
	model	"models\_new\meteorite1_medium.mdl"
	skin	"models\_new\meteorite.tga"
	shadow	SHADOW_PROJECTED

	attach  id "PS_FIRE" PS_METEORITE_MEDIUM_FALLING "origin"
	attach  id "PS_SMOKE" PS_METEORITE_MEDIUM_FALLING_SMOKE "origin"

	attach	"meteorite_small_flare" "origin"

	script	"scripts\_new\meteorite_medium_falling.scr"
}


meteorite_gray_medium_dead {
        flag    FL_ONGROUND
	model	"models\_new\meteorite1_medium.mdl"
	skin	"models\_new\meteorite.tga"
}


