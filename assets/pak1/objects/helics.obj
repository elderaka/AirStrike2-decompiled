///////////////////////////////////////////////////////////////////
helic_redflare {
        type    TYPE_SPRITE
        skin    "models\helics\redflare.tga"
        blend   BLEND_ADD
        sort    SORT_ONGROUND
        rflag   RF_NODEPTHWRITE
        min     -4 -4 0.0 0.0
        max     4 4 1.0 1.0
}

