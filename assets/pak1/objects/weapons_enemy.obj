	type    TYPE_SPRITE
	skin    "models\weapons\wavegun\flash.tga"
	blend   BLEND_ADD

	flag    FL_TEMPORARY

	min     -40 -40   0 0
	max     40 40     1 1

	script  "scripts\weapons\laser\flash.scr"
}


