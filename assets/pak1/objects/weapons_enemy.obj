
// Enemy Weapons

light_magenta2 {
        light   150 2 0.7 2
}


// ===========================================================================
//
// MACHINEGUN
//
// ===========================================================================

e_mgun_proj {
	touch	TOUCH_PLAYER
	model	"models\weapons_enemy\mgun\mgun.mdl"
	skin	"models\weapons_enemy\weapons_enemy2.tga"
	blend	BLEND_ADD

	rflag	RF_NOCULLING
	rflag	RF_NODEPTHTEST
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT

	damage	5

	script	"scripts\weapons_enemy\mgun\mgun_proj.scr"
}

e_mgun_blue_proj {
	touch	TOUCH_PLAYER
	model	"models\weapons_enemy\mgun\mgun_blue.mdl"
	skin	"models\weapons_enemy\weapons_enemy2.tga"
	blend	BLEND_ADD

	rflag	RF_NOCULLING
	rflag	RF_NODEPTHTEST
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT

	damage	5

	script	"scripts\weapons_enemy\mgun\mgun_blue_proj.scr"
}


e_mgun_flash {
	type    TYPE_SPRITE
	skin    "models/weapons_enemy/laser/flashes.tga"
	blend   BLEND_ADD

	flag    FL_TEMPORARY

	frames  2 4
	min     -5 -5   0 0
	max     5 5     1 1

	script	"scripts\weapons_enemy\laser\flash_orange.scr"
}

e_mgun2_flash {
	model	"models\weapons_enemy\mgun\flash.mdl"
	skin	"models\weapons\mgun\mgfire.tga"
	blend	BLEND_ADD
	flag	FL_TEMPORARY

	rflag	RF_NOCULLING
	rflag	RF_NODEPTHWRITE
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT
	script	"scripts\weapons\laser\flash.scr"
}


e_mgun_blue_flash {
	model	"models\weapons_enemy\mgun\flash.mdl"
	skin	"models\weapons\laser\plasma_flash.tga"
	blend	BLEND_ADD
	flag	FL_TEMPORARY

	rflag	RF_NOCULLING
	rflag	RF_NODEPTHWRITE
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT
	script	"scripts\weapons\laser\flash.scr"
}

e_mgun_hit {
	flag FL_NODRAW
	attach PS_ISKORKA "origin" 
	script "scripts\weapons\hit.scr"
}

e_mgun_blue_hit {
	flag FL_NODRAW
	attach PS_ISKORKA "origin" 
	script "scripts\weapons\hit.scr"
}




// =============================================================================
//
// IMPULSEGUN
//
// =============================================================================

e_impulse_flare {
	type	TYPE_SPRITE
	skin	"models\weapons\impulse\flare.tga"
	blend	BLEND_ADD
	rflag	RF_NODEPTHTEST

	min	-2.5 -2.5 0.0 0.0
	max	2.5 2.5 1.0 1.0	
}

e_impulse_proj {
	touch	TOUCH_PLAYER
	model	"models\weapons_enemy\impulse\impulse_helic.mdl"
	skin	"models\weapons_enemy\weapons_enemy.tga"
	rflag	RF_NOCULLING
	rflag	RF_NODEPTHTEST
	blend	BLEND_ADD
	sort	SORT_EFFECT

	damage	10

	script	"scripts\weapons_enemy\impulse\igun_proj.scr"
	attach	"e_impulse_flare" "tag_flare"
}

e_impulse_flash {
	type    TYPE_SPRITE
	skin    "models/weapons_enemy/impulse/flash.tga"
	blend   BLEND_ADD

	flag    FL_TEMPORARY
	frames  2 4
	min     -5 -5   0 0
	max     5 5     1 1

	script  "scripts\weapons_enemy\impulse\igun_flash.scr"
}

e_impulse_hit {
	type    TYPE_SPRITE
	skin    "gfx\weapons\hits.tga"
	blend   BLEND_ADD
	rflag	RF_NODEPTHTEST
	rflag	RF_NOLIGHTING

	flag    FL_TEMPORARY

	min     -4 -4   0.25     0.0
	max     4  4    0.5  0.25

	script  "scripts\weapons_enemy\hit.scr"
}



