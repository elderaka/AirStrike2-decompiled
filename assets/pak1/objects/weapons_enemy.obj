	model	"models\weapons_enemy\fballs\bfg\plane.mdl"
	skin	"models\weapons_enemy\fballs\bfg\bfg_plane.tga"
	blend	BLEND_ADD

	rflag	RF_NOCULLING
        rflag   RF_NODEPTHTEST
        rflag   RF_NOLIGHTING
        sort    SORT_EFFECT

	script	"scripts\bonuses\lightingbomb\lightingbomb_plane.scr"
}

lightingbomb_proj2 {
	touch	TOUCH_PLAYER
	model	"models\weapons_enemy\fballs\bfg\sfera.mdl"
	skin	"models\weapons\bfg\bfgball.tga"
	blend	BLEND_ADD

	light	150 0.3 0.3 3

        rflag   RF_NODEPTHTEST
        rflag   RF_NOLIGHTING
        sort    SORT_EFFECT

	script	"scripts\weapons_enemy\fball\bfg\lightingbomb_proj.scr"

	attach	"lball_flare2" "origin"

	attach	abs "lball_plane2" "origin"
	attach	abs "lball_plane2" "origin"
	attach	abs "lball_plane2" "origin"
	attach	abs "lball_plane2" "origin"
	attach	abs "lball_plane2" "origin"
	attach	abs "lball_plane2" "origin"
}

