
yellowflare {
        type    TYPE_SPRITE
        skin    "models\mapobjects\zabors\yellowflare.tga"
        blend   BLEND_ADD
        sort    SORT_flag
        rflag   RF_NODEPTHWRITE
        min     -4 -4 0.0 0.0
        max     4 4 1.0 1.0
}

///////////////zabors////////////////////

zabor_metal {
	model	"models\mapobjects\zabors\zabor_metal.mdl"
	skin	"models\mapobjects\zabors\zabor.tga"
	shadow	SHADOW_PROJECTED
        rflag   RF_NOCULLING
        rflag   RF_NODEPTHWRITE
        sort    SORT_TRANS
	blend	BLEND_ALPHA
        attach  "yellowflare" "tag_flare"
	flag    FL_ONGROUND

}

