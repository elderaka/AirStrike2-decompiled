// ===========================================================================
//
// MACHINEGUN
//
// ===========================================================================

mgun_proj {
	touch	TOUCH_ENEMIES
	model	"models\weapons\laser\mgun.mdl"
	skin	"models\weapons\laser\weapons.tga"
	blend	BLEND_ADD

	flag	FL_POINT_COLLISION
	rflag	RF_NOCULLING
	rflag	RF_NODEPTHTEST
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT

	damage	6

	script	"scripts\weapons\mgun\mgun_proj.scr"
}


mgun_flash {
	model	"models\weapons\mgun\mgfire.mdl"
	skin	"models\weapons\laser\laser_flash.tga"
	blend	BLEND_ADD
	flag	FL_TEMPORARY
 
	rflag	RF_NOCULLING
	rflag	RF_NODEPTHWRITE
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT
  
	attach "mgun_flare" origin

	script	"scripts\weapons\mgun\mgun_flash.scr"
}

mgun_flare {
	type	TYPE_SPRITE
	skin	"gfx\effects\flash_yellow.tga"
	blend	BLEND_ADD
	rflag	RF_NODEPTHWRITE

	min	-40 -40 0.0 0.0
	max	40 40 1.0 1.0	
}


mgun_hit {
	flag FL_NODRAW
	attach PS_ISKORKA "origin" 
	script "scripts\weapons\hit.scr"
}


mgun_trasser {
	model	"models\weapons\trassers\mgun_trasser.mdl"
	skin	"models\weapons\trassers\trassers.tga"
	blend	BLEND_ALPHA

	rflag	RF_NOCULLING
	rflag	RF_NODEPTHTEST
	rflag	RF_NOLIGHTING
	sort	SORT_EFFECT

	script	"scripts\weapons\mgun\mgun_trasser.scr"
}


