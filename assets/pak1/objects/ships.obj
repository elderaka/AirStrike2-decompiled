//////////////////////////////////////////////////////////////
////////////////ship_destroyer///////////////////////////////
////////////////////////////////////////////////////////////


ship_destroyer_guns {
        model   "models\ships\ship_destroyer_guns.mdl"
        skin    "models\ships\ship1.tga"

	attach abs night "svet_far" "tag_fara"
        script  "scripts\ships\ship_destroyer\ship_destroyer_guns.scr"
}


ship_destroyer_cannon {
        model   "models\ships\ship_destroyer_cannon.mdl"
        skin    "models\ships\ship1.tga"

	attach abs id "GUNS" "ship_destroyer_guns" "tag_guns"

        script  "scripts\ships\ship_destroyer\ship_destroyer_cannon.scr"
}

ship_destroyer_radar {
        model   "models\ships\ship_destroyer_radar.mdl"
        skin    "models\ships\ship_radar.tga"
        blend   BLEND_ALPHA
        rflag   RF_NOCULLING
        rflag   RF_NODEPTHWRITE
        sort    SORT_TRANS

        script  "scripts\ships\ship_destroyer\ship_destroyer_radar.scr"
}

ship_destroyer {
        health  800
        enemy

	flag	FL_ONWATER_NORMAL

	score	1000	

        model   "models\ships\ship_destroyer.mdl"
        skin    "models\ships\ship1.tga"

        attach abs "ship_destroyer_cannon" "tag_cannon"
        attach  "ship_destroyer_radar" "tag_radar"
        attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_ALMOSTDEAD" origin

        attach  "helic_redflare" "tag_flare3"
        attach  "whiteflare_small" "tag_flare1"
        attach  "whiteflare_small" "tag_flare2"

	attach abs id "SPLASHES" PS_SHIP_SPLASHES "tag_splash"

	script	"scripts\ships\ship_destroyer\ship_destroyer.scr"
} 

