
////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////// train ////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////


boss_3_train {

	enemy
	health  13000
	
	score	50000
	flag	FL_TEMPORARY

	touch	TOUCH_PLAYER

	model   "models\bosses\boss_3_train\vagon01_base.mdl"
	skin    "models\bosses\boss_3_train\vagon01.tga"
//	shadow  SHADOW_PROJECTED


//	attach id "COVER" "boss_2_kabina" "tag_kabina"

	attach abs "svet_far_helic" "tag_fara01"

	attach abs "boss_3_train_wheel" "tag_wheel01"
	attach abs "boss_3_train_wheel" "tag_wheel02"
	attach abs "boss_3_train_wheel" "tag_wheel03"
	attach abs "boss_3_train_wheel" "tag_wheel04"
	attach abs "boss_3_train_wheel" "tag_wheel05"
	attach abs "boss_3_train_wheel" "tag_wheel06"

	attach abs "boss_3_train_turret" "tag_turret01"
	attach abs "boss_3_train_turret" "tag_turret02"

//	attach abs "vagon_02" "tag_vagon02"

//	attach id "PROGRESS_FLARE1" "boss_yellowflare" "tag_flare01"
//	attach id "PROGRESS_FLARE2" "boss_yellowflare" "tag_flare02"

	script	"scripts\bosses\boss_3_train\train.scr"
}

boss_3_train_gun {

	model   "models\bosses\boss_3_train\vagon01_gun.mdl"
	skin    "models\bosses\boss_3_train\vagon01.tga"

	script	"scripts\bosses\boss_3_train\train_gun.scr"
}

boss_3_train_turret {

	model   "models\bosses\boss_3_train\vagon01_turret.mdl"
	skin    "models\bosses\boss_3_train\vagon01.tga"

	attach id "GUNS" abs "boss_3_train_gun" "tag_gun01"

	script	"scripts\bosses\boss_3_train\train_turret.scr"
}

boss_3_train_wheel {

	model   "models\bosses\boss_3_train\train_wheel.mdl"
	skin    "models\bosses\boss_3_train\vagon03.tga"

	script	"scripts\bosses\boss_3_train\train_wheel.scr"
}


