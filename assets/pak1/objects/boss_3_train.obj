vagon04_helic {
	flag    FL_TEMPORARY
	touch   TOUCH_PLAYER
	model	"models\helics\helic_tiger\helic_tiger.mdl"
	skin	"models\helics\helic_tiger\helic_tiger.tga"
	shadow	SHADOW_PLANAR_HIGH
	
	health	1500

	enemy
	score   1700

	attach abs	"vint_c4_red"	"tag_vint1"
	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_HELIC_ALMOSTDEAD" origin
//	attach abs "vint_a3_red"	"tag_vint"
