
p_expl1 {
	flag    FL_NODRAW
	script	"scripts\effects\p_expl1.scr"
	attach  PS_EXPLOSION_SPARKS "origin"
}

p_expl_wave {
	model	"models\misc\sphere.mdl"
	skin	"models\misc\hlanno.tga"
        blend	BLEND_ADD
	rflag	RF_NOLIGHTING
	rflag	RF_NODEPTHWRITE
	script	"scripts\effects\p_wave.scr"
}


p_speedup {
	flag	FL_TEMPORARY
	flag	FL_NODRAW
	script	"scripts\player\common\p_speedup.scr"
}

p_speeddown {
	flag	FL_TEMPORARY
	flag	FL_NODRAW
	script	"scripts\player\common\p_speeddown.scr"
}

