        flag    FL_TEMPORARY
	model	"models\helics\player1\player1_shield.mdl"
        skin    "gfx\black.tga"

        envmap  "gfx\effects\shield.tga"
        envmode ENV_QUAD

        rflag   RF_NOLIGHTING
        blend   BLEND_ADD
	script	"scripts\player\common\p_shield.scr"
}

player1_rshield {

        flag    FL_TEMPORARY
	model	"models\helics\player1\player1_shield.mdl"
        skin    "gfx\black.tga"

        envmap  "gfx\effects\shield.tga"
        envmode ENV_QUAD

        rflag   RF_NOLIGHTING
        blend   BLEND_ADD
	script	"scripts\player\common\p_rshield.scr"
}

player1_kabina {

	model	"models\helics\player1\player1_kabina.mdl"
	skin	"models\helics\player1\player1_kabina.tga"
	envmap	"gfx\chrome2.tga"
	envmode	ENV_GLITTER
        blend   BLEND_ALPHA
}

player_1 {

	player

	health	500
	speed	1.0

	flag	FL_TEMPORARY
                 
	model	"models\helics\player1\player1_base.mdl"
	skin	"models\helics\player1\player1.tga"

	envmap	"gfx\envmap4.tga"
	envmode	ENV_GLITTER

	shadow	SHADOW_PLANAR_PROJECTED_HIGH
	attach abs night  "svet_far_helic" "tag_fara"
	attach	"helic_redflare" "tag_flare01"
	attach	"helic_redflare" "tag_flare02"
	attach	"helic_redflare" "tag_flare03"
	attach	"whiteflare_small" "tag_flare04"
	attach	"whiteflare_small" "tag_flare05"

	attach abs "player1_kabina" "tag_kabina"

	attach abs "player1_vint" "tag_vint1"
	attach abs "player1_vint_small" "tag_vint02"

	attach id "FLAMETHROWER"  "flamefrower_proj" "tag_fire01"
	attach id "FLAMETHROWER2" "flamefrower2_proj" "tag_fire01"
	attach id "FLAMETHROWER3" "flamefrower3_proj" "tag_fire01"

	attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_HELIC_ALMOSTDEAD" origin
	attach id "CAMPFIRE_ALMOSTDEAD2" "PS_CAMPFIRE_HELIC_ALMOSTDEAD_LARGE" origin

	script	"scripts\player\player1\player1.scr"
}

player1_vint {

	model	"models\helics\player1\player1_vint.mdl"
	skin	"models\helics\player1\vint_blue.tga"
	
	blend	BLEND_ALPHA
	rflag	RF_NOCULLING
	rflag	RF_NODEPTHWRITE
	sort	SORT_TRANS
	script	"scripts\player\player1\player1_vint.scr"
}

player1_vint_small {

	model	"models\helics\vints\vint_small.mdl"
	skin	"models\helics\vints\vint_small.tga"
	
	blend	BLEND_ALPHA
	rflag	RF_NOCULLING
	rflag	RF_NODEPTHWRITE
	sort	SORT_TRANS

