//////////////////////////////// player1 //////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////

bomber_bomb {
	flag FL_TEMPORARY

	model	"models\mapobjects\barrel\barrel1.mdl"
	skin	"models\mapobjects\misc\misc.tga"

	script	"scripts\player\bomber_bomb.scr"
}
                                              
player_bomber 
{
        health  1000
        civilian


        model   "models/planes/plane_a/plane_a.mdl"
        skin    "models/planes/plane_a/plane_a_blue.tga"
        shadow  SHADOW_PLANAR_LOW

	envmode	ENV_GLITTER
	envmap  "gfx\chrome3.tga"

	attach  "helic_redflare" "tag_flare01"
	attach  "helic_redflare" "tag_flare02"
	attach  "whiteflare_small" "tag_flare03"
	attach  "whiteflare_small" "tag_flare04"
	attach  "helic_redflare" "tag_flare05"
	attach  "helic_redflare" "tag_flare06"
	attach  "helic_redflare" "tag_flare07"

//        attach abs night "svet_far" "tag_fara"
        attach id "CAMPFIRE_ALMOSTDEAD" "PS_CAMPFIRE_HELIC_ALMOSTDEAD" origin

	script	"scripts\player\bomber.scr"
}

player1_moln {

	flag	FL_TEMPORARY
	model	"models\helics\player1\player1_shield.mdl"
	skin	"gfx\black.tga"

	envmap	"gfx\effects\moln.tga"
	envmode	ENV_QUAD

	rflag	RF_NOLIGHTING
	blend	BLEND_ADD
	script	"scripts\player\common\p_moln.scr"
}

