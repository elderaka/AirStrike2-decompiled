
end_of_the_level {
	flag	FL_ONGROUND
	flag	FL_NODRAW
	flag	FL_TEMPORARY
	script	"scripts\eol.scr"
}

hbar_empty {
        type    TYPE_SPRITE
        skin    "gfx\hbar_0.tga"
        rflag   RF_NODEPTHTEST
	sort	SORT_EFFECT
        min     -16 -1.3 0.0 0.0
        max     16 1.3 1.0 1.0
}

hbar_full {
        type    TYPE_SPRITE
        skin    "gfx\hbar_1.tga"
        rflag   RF_NODEPTHTEST
	sort	SORT_EFFECT
        min     -16 -1.3 0.0 0.0
        max     16 1.3 1.0 1.0
}

svet_far_light {
        light   100 2 2 1
} 

svet_fonar_light {
        light   100 2 2 0.6
} 

svet_big {
        light   250 2.5 2.5 0.6
} 

svet_far {
	model   "models/misc/svet_far.mdl"
        skin    "models/misc/svet_far.tga"
        blend   BLEND_ADD
//	rflag   RF_NOCULLING
        rflag   RF_NODEPTHWRITE

//	light_dir 200 2 2 1 0 1 -0.5 80
	attach	"svet_far_light" "tag_light"	
} 

svet_far_wol {
	model   "models/misc/svet_far.mdl"
        skin    "models/misc/svet_far.tga"
        blend   BLEND_ADD
//	rflag   RF_NOCULLING
        rflag   RF_NODEPTHWRITE

//	light_dir 200 1.2 1.2 1 0 1 -0.5 80
//	attach	"svet_far_light" "tag_light"	
} 

svet_far_helic {
	model   "models/misc/svet_far_helic.mdl"
        skin    "models/misc/svet_far.tga"
        blend   BLEND_ADD
	rflag   RF_NOCULLING
        rflag   RF_NODEPTHWRITE

	light_dir 400 1.1 1.1 0.8 0 1 -0.5 60
//	attach	"svet_far_light" "tag_light"	
} 

yellowflare_fonar {
        type    TYPE_SPRITE
        skin    "gfx\effects\fonarflare.tga"
        blend   BLEND_ADD
        sort    SORT_ONGROUND
//        rflag   RF_NODEPTHWRITE
        min     -15 -15 0.0 0.0
        max     15 15 0.5 1.0
}

whiteflare_fonar {
        type    TYPE_SPRITE
        skin    "gfx\effects\fonarflare.tga"
        blend   BLEND_ADD
        sort    SORT_ONGROUND
//        rflag   RF_NODEPTHWRITE
        min     -15 -15 0.5 0.0
        max     15 15 1.0 1.0
}

redflare_fonar {
        type    TYPE_SPRITE
        skin    "gfx\effects\fonarflare_red.tga"
        blend   BLEND_ADD
        sort    SORT_ONGROUND
//        rflag   RF_NODEPTHWRITE
        min     -15 -15 0.0 0.0
        max     15 15 1.0 1.0
}


svet_fonar {
	model   "models/misc/svet_fonar.mdl"
        skin    "models/misc/svet_far.tga"
        blend   BLEND_ADD
//	rflag   RF_NOCULLING
        rflag   RF_NODEPTHWRITE
	attach	"svet_fonar_light" "tag_light"	
        attach "yellowflare_fonar" origin
} 

svet_fonar_big {
	model   "models/misc/svet_fonar_big.mdl"
	skin    "models/misc/svet_far.tga"
	blend   BLEND_ADD
	rflag   RF_NODEPTHWRITE
//	attach	"svet_far_light" "tag_light"	
        attach "whiteflare_fonar" origin
} 

svet_fonar_stad {
	model   "models/misc/svet_fonar_stad.mdl"
	skin    "models/misc/svet_far.tga"
	blend   BLEND_ADD
	rflag   RF_NODEPTHWRITE
	light_dir 300 2 2 1 0 -1 -1 80
        attach "whiteflare_fonar" origin
} 

svet_fonar_stad_wol {
	model   "models/misc/svet_fonar_stad.mdl"
	skin    "models/misc/svet_far.tga"
	blend   BLEND_ADD
	rflag   RF_NODEPTHWRITE
        attach "whiteflare_fonar" origin
} 


lighting_nature {
	model   "models/misc/lighting_nature.mdl"
	skin    "models/misc/lighting_nature.tga"
	blend   BLEND_ADD

	rflag   RF_NODEPTHWRITE
	rflag   RF_NOCULLING
	sort	SORT_EFFECT
	rflag	RF_NOLIGHTING

	script	"scripts/misc/lighting_nature.scr"
}