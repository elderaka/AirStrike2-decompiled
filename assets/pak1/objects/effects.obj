
fx_item_taken {
        flag    FL_NODRAW
        attach  "PS_ITEM_TAKEN" "origin"
	script	"scripts\weapons\hit5.scr"
}

mark {
	type	TYPE_MARK
	skin	"gfx\mark.tga"
	blend	BLEND_FILTER
	min	-50 -50 0 0
	max	50 50 1 1
	script	"scripts\weapons\hit10.scr"
}

splash {
	model	"models\misc\splash.mdl"
	skin	"gfx\splash.tga"
	rflag	RF_NOLIGHTING
	rflag	RF_NODEPTHWRITE
	sort	SORT_ONGROUND
	blend	BLEND_ADD
	
	script	"scripts\effects\splash.scr"
}

campfire_light {
	flag    FL_NODRAW
	script "scripts\effects\campfire.scr"
}

campfire_light_small {
	flag    FL_NODRAW
	script "scripts\effects\campfire_small.scr"
}


campfire {
	flag    FL_NODRAW
	attach	PS_CAMPFIRE "origin"
	attach	PS_EXPLOSION_FIRE "origin"
	attach	campfire_light "origin"
}



campfire_small {
	flag    FL_NODRAW
	attach	PS_CAMPFIRE_SMALL2 "origin"
//	attach	campfire_light "origin"
//	attach	PS_EXPLOSION_FIRE "origin"
}

helic_campfire {
	flag    FL_NODRAW
	attach	PS_CAMPFIRE_SMALL "origin"
	attach	PS_EXPLOSION_FIRE_SMALL "origin"
//	attach	campfire_light "origin"
}


barreltrail {
	flag    FL_NODRAW
	attach	PS_BARRELTRAIL "origin"
}

score_num {
	type	TYPE_SPRITE
	skin	"gfx\scores.tga"
	blend	BLEND_ADD
	rflag	RF_NODEPTHTEST

	frames	10 1
	min	-6 -8  0 0
	max	6 8    1 1	

	script	"scripts\effects\scorenum.scr"
}

// ONGROUND EXPLOSION

gib_flare {
	type	TYPE_SPRITE
	skin	"gfx\effects\gibflare.tga"
	blend	BLEND_ADD
	rflag	RF_NODEPTHWRITE

	min	-17 -17 0.0 0.0
	max	17 17 1.0 1.0	
}

gib_spark {
	type	TYPE_SPRITE
	skin	"gfx\effects\gibspark.tga"
	blend	BLEND_ADD
	rflag	RF_NODEPTHWRITE

	min	-6 -6 0.0 0.0
	max	6 6 1.0 1.0	
	script	"scripts\effects\gib_spark.scr"
}

